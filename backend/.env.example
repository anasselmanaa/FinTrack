APP_ENV=production
FLASK_SECRET_KEY=
FRONTEND_ORIGINS=https://your-frontend-domain.com

# Use DATABASE_URL in production.
DATABASE_URL=

# Local DB fallback if DATABASE_URL is not set.
DB_NAME=fintrack
DB_USER=mac
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Keep this false in production.
FINTRACK_DEV_AUTO_LOGIN=false
FINTRACK_LOCAL_AUTO_LOGIN=false
FINTRACK_SHOW_DEMO_DATA=false

# Required only for Money Coach / AI features.
# Claude is the only AI provider used by the backend.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional Claude tuning (defaults shown).
# Model: claude-sonnet-4-6 (recommended), claude-opus-4-7 (highest quality), claude-haiku-4-5 (fastest)
CLAUDE_MODEL=claude-sonnet-4-6
# Effort: low | medium | high | xhigh | max
CLAUDE_EFFORT=high
# Thinking: adaptive | disabled
CLAUDE_THINKING=adaptive

# Optional Claude cost accounting, USD per 1M tokens.
CLAUDE_INPUT_COST_PER_MTOK=3
CLAUDE_OUTPUT_COST_PER_MTOK=15
CLAUDE_CACHE_WRITE_COST_PER_MTOK=3.75
CLAUDE_CACHE_READ_COST_PER_MTOK=0.30

# Stripe billing.
# If price IDs are left empty, the backend lazily creates/finds FinTrack Pro prices
# with lookup keys fintrack_pro_monthly_usd and fintrack_pro_monthly_cad.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_USD_ID=
STRIPE_PRICE_CAD_ID=
STRIPE_PRODUCT_NAME=FinTrack Pro
STRIPE_TRIAL_DAYS=14
FRONTEND_APP_URL=https://your-frontend-domain.com
# Optional explicit return URLs. Defaults to FRONTEND_APP_URL/?billing=...
FRONTEND_BILLING_SUCCESS_URL=
FRONTEND_BILLING_CANCEL_URL=

# Resend transactional email.
# Create an API key and verify your sending domain in Resend before production.
EMAIL_ENABLED=true
RESEND_API_KEY=
EMAIL_FROM=FinTrack <hello@fintrack.app>
EMAIL_REPLY_TO=help@fintrack.app
SUPPORT_EMAIL=help@fintrack.app
BUGS_EMAIL=bugs@fintrack.app
IDEAS_EMAIL=ideas@fintrack.app
TRIAL_EMAILS_ENABLED=true
TRIAL_EMAILS_USER_LIMIT=500
PASSWORD_RESET_TOKEN_MINUTES=60
EMAIL_VERIFICATION_TOKEN_MINUTES=1440
EMAIL_VERIFICATION_REQUIRED=true

# Shared admin token for manual scheduled jobs.
INSIGHTS_CRON_ADMIN_TOKEN=

# Cookie settings for cross-domain frontend/backend deployments.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=None

PORT=5001
